# Database Configuration
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=labtrack
DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/labtrack

# Google Gemini API Key for blood test AI extraction
# If not provided, LabTrack automatically uses the built-in intelligent fallback parser
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.8-flash

# Storage & Uploads
UPLOAD_DIR=./uploads

# CORS
CORS_ORIGINS=*

